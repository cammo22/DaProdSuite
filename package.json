{
  "name": "daprodgiochi",
  "version": "2.0.0",
  "private": true,
  "description": "La sala giochi privata DaProd: hub Rust e telefoni Android.",
  "scripts": {
    "dev": "cargo run -p daprodgiochi --features desktop",
    "server": "cargo run -p daprodgiochi -- --headless",
    "build": "cargo build -p daprodgiochi --release --features desktop",
    "prova": "cargo test --workspace",
    "typecheck": "cargo check --workspace --all-targets --features desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4"
  }
}
