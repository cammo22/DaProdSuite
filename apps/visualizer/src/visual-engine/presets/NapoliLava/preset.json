{
  "schemaVersion": 1,
  "id": "daprod.napoli-lava",
  "name": "Lava di Napoli",
  "author": "DaProdVisualizer Team",
  "version": "1.0.0",
  "category": "Astratto",
  "description": "Colate incandescenti sui bassi, mare scuro e luci urbane che scintillano sugli alti. Nessun asset esterno.",
  "entry": "scene.ts",
  "performance": "high",
  "minimumRenderer": "webgl2",
  "parameters": {
    "flowSpeed": {
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 3,
      "label": "Colata"
    },
    "heat": {
      "type": "number",
      "default": 1,
      "min": 0.2,
      "max": 2,
      "label": "Calore"
    },
    "cityLights": {
      "type": "number",
      "default": 0.8,
      "min": 0,
      "max": 2,
      "label": "Luci citta'"
    }
  },
  "audioMappings": [
    {
      "source": "bass",
      "target": "surge",
      "amount": 1,
      "smoothing": 0.2
    },
    {
      "source": "treble",
      "target": "sparks",
      "amount": 1,
      "smoothing": 0.06
    },
    {
      "source": "onset",
      "target": "eruption",
      "amount": 1,
      "smoothing": 0.3
    }
  ]
}
