{
  "schemaVersion": 1,
  "id": "daprod.liquid-chrome",
  "name": "Cromo Liquido",
  "author": "DaProdVisualizer Team",
  "version": "1.2.0",
  "category": "Liquido",
  "description": "Un mare di metallo fuso: onde lunghe e cerchi che si allargano dove qualcosa cade.",
  "entry": "scene.ts",
  "performance": "high",
  "minimumRenderer": "webgl2",
  "parameters": {
    "flow": { "type": "number", "default": 1.0, "min": 0.1, "max": 3.0, "label": "Scorrimento" },
    "roughness": { "type": "number", "default": 0.35, "min": 0.0, "max": 1.0, "label": "Ruvidita'" },
    "tint": { "type": "number", "default": 0.55, "min": 0.0, "max": 1.0, "label": "Tinta" },
    "drops": { "type": "number", "default": 1.0, "min": 0.0, "max": 2.5, "label": "Onde d'impatto" }
  },
  "audioMappings": [
    { "source": "bass", "target": "swell", "amount": 1.0, "smoothing": 0.18 },
    { "source": "mid", "target": "shine", "amount": 1.0, "smoothing": 0.1 },
    { "source": "onset", "target": "ripple", "amount": 1.0, "smoothing": 0.06 },
    { "source": "beat", "target": "splash", "amount": 1.0, "smoothing": 0.12 }
  ]
}
