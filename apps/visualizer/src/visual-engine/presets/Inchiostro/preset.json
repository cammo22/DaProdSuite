{
  "schemaVersion": 1,
  "id": "daprod.inchiostro",
  "name": "Inchiostro",
  "author": "DaProdVisualizer Team",
  "version": "1.0.0",
  "category": "Liquido",
  "description": "Inchiostro colorato che si apre nell'acqua, trascinato da una corrente invisibile.",
  "entry": "scene.ts",
  "performance": "high",
  "minimumRenderer": "webgl2",
  "parameters": {
    "current": { "type": "number", "default": 1.0, "min": 0.1, "max": 3.0, "label": "Corrente" },
    "density": { "type": "number", "default": 1.0, "min": 0.2, "max": 2.0, "label": "Densita'" },
    "filaments": { "type": "number", "default": 1.0, "min": 0.0, "max": 2.0, "label": "Filamenti" }
  },
  "audioMappings": [
    { "source": "onset", "target": "release", "amount": 1.0, "smoothing": 0.4 },
    { "source": "bass", "target": "swirl", "amount": 1.0, "smoothing": 0.3 },
    { "source": "treble", "target": "grain", "amount": 1.0, "smoothing": 0.12 }
  ]
}
