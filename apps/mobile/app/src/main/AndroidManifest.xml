<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Rete locale: il gateway della suite sta nella LAN di casa. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Per vedere se il PC di casa è raggiungibile quando si è fuori. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Le notifiche quando un lavoro finisce. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      La sentinella: resta sveglia mentre il computer sta finendo un tuo lavoro,
      e si spegne da sola appena ha finito. Serve perché il lavoro periodico di
      Android non scende sotto il quarto d'ora, e dentro Doze diventa un'ora:
      per «il video è pronto» è troppo tardi. Vedi Sentinella.kt.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Per installare l'aggiornamento dell'app che si scarica da sola.
         Su Android 8 e oltre va comunque concesso a mano una volta sola. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Camera per inquadrare il QR. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:label="DaProd Suite"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/ThemeDaProdSuite"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Il modo di passare l'APK scaricato all'installatore di Android:
             da Android 7 un file non si consegna più come percorso. Espone una
             cartella sola, quella degli aggiornamenti. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.file"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/percorsi_file" />
        </provider>

        <!--
          La sentinella. `exported="false"`: la fa partire solo l'app stessa,
          quando va in secondo piano con qualcosa in ballo sul computer.
        -->
        <service
            android:name=".Sentinella"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Lo scanner del QR: un'activity della libreria zxing. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            android:theme="@style/ThemeDaProdSuite.Camera"
            tools:replace="android:theme,android:screenOrientation"
            android:exported="false" />
    </application>
</manifest>