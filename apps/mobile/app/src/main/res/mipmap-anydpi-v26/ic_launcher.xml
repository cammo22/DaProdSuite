<?xml version="1.0" encoding="utf-8"?>
<!--
  L'icona dell'app: il marchio DaProd, rifatto nella 1.4.7 coi colori della
  suite (la D nell'anello verde e ciano). Il disegno sta in
  `drawable/logo_daprod.xml`.

  Niente `<background>` separato: il disegno ha il suo cielo dentro, e un fondo
  in piu' sotto lo coprirebbe ai bordi su certi telefoni.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/logo_daprod" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
