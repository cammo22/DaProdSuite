                <item android:offset="0" android:color="#FFB8FFD0" />
                <item android:offset="0.5" android:color="#FF00FF41" />
                <item android:offset="1" android:color="#FF3DDBFF" />
            </gradient>
        </aapt:attr>
        </path>
        <path android:pathData="M32,11a21,21 0 1,0 0,42a21,21 0 1,0 0,-42z" android:strokeColor="#593DDBFF" android:strokeWidth="1.2" />
        <path android:fillType="evenOdd"
            android:pathData="M24,19h9.5c8,0 13,5 13,13s-5,13 -13,13H24z M30,25v14h3.2c4.3,0 7,-2.6 7,-7s-2.7,-7 -7,-7z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="19" android:endX="0" android:endY="45">
                <item android:offset="0" android:color="#FFEAFFF2" />
                <item android:offset="0.45" android:color="#FF5DFF8A" />
                <item android:offset="1" android:color="#FF1FC8FF" />
            </gradient>
        </aapt:attr>
        </path>
        <!-- Il lucido del vetro sulla metà di sopra, come i bottoni aqua. -->
        <path android:pathData="M7.5,30A24.5,24.5 0 0,1 56.5,30C44,25 20,25 7.5,30z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="5.5" android:endX="0" android:endY="30">
                <item android:offset="0" android:color="#61FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
