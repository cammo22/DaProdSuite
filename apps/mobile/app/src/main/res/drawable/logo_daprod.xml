<?xml version="1.0" encoding="utf-8"?>
<!--
  Il marchio **DaProd Produzioni**: sole al tramonto, griglia, neon.

  Chiesto il 26 agosto 2026: «usiamo la seconda immagine come logo anche per
  android e anche per le notifiche android».

  ⚠ **Questo è un disegno, non quell'immagine.** L'immagine vera è un file che
  sta fuori dal repository, e un disegno vettoriale non la può riprodurre riga
  per riga: quello che c'è qui sono i suoi pezzi — il sole a fette, l'anello di
  neon, la griglia in prospettiva, i due colori — messi insieme in modo da
  riconoscersi sullo schermo di un telefono da 48 px.

  **Per mettere quella vera** bastano due mosse, e non serve toccare il codice:
  1. salva il PNG (512×512, sfondo compreso) come
     `apps/mobile/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png`;
  2. cancella `mipmap-anydpi-v26/ic_launcher.xml`, che è quello che dice ad
     Android di usare questo disegno al posto del file.

  ## Perché vettoriale e non un PNG, per adesso

  Perché un'icona di Android vive a otto misure diverse — dalla lista delle app
  al riquadro delle notifiche — e un PNG a una misura sola si vede sgranato in
  almeno tre di quelle. Un vettore è nitido ovunque e pesa due chili di niente.

  ## Le proporzioni non sono decorative

  Il disegno sta in 108×108 come vuole un'icona adattiva, ma **tutto quello che
  conta sta nei 66 dp centrali**: fuori da lì Android ritaglia, e su certi
  telefoni ritaglia un cerchio. Il sole e la scritta stanno dentro quel cerchio;
  la griglia e l'anello possono uscirne, ed è giusto che escano — sono lo sfondo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Il cielo: viola scuro verso il nero, come nel marchio. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startY="0"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF1A0B2E" />
                <item android:offset="1" android:color="#FF0B0616" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- L'anello di neon: ciano, come il cerchio esterno del marchio. -->
    <path
        android:pathData="M54,20a34,34 0 1,0 0,68a34,34 0 1,0 0,-68"
        android:strokeColor="#FF22D3EE"
        android:strokeWidth="2.2"
        android:strokeAlpha="0.9" />
    <path
        android:pathData="M54,17a37,37 0 1,0 0,74a37,37 0 1,0 0,-74"
        android:strokeColor="#FFF472B6"
        android:strokeWidth="1.1"
        android:strokeAlpha="0.55" />

    <!--
      Il sole a fette.

      Le fette sono quattro e non otto: a 48 px otto fette diventano una
      sfumatura grigia, e il segno che si riconosce è che il sole **è tagliato**.
    -->
    <group>
        <clip-path android:pathData="M54,30a21,21 0 1,0 0,42a21,21 0 1,0 0,-42" />
        <path android:pathData="M33,30h42v42h-42z">
            <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
                <gradient
                    android:startY="30"
                    android:endY="72"
                    android:type="linear">
                    <item android:offset="0" android:color="#FFFFC24D" />
                    <item android:offset="0.45" android:color="#FFFF6B4A" />
                    <item android:offset="1" android:color="#FFE0357B" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- I tagli: righe di cielo dentro al sole. -->
        <path android:fillColor="#FF120823" android:pathData="M33,53h42v2.4h-42z" />
        <path android:fillColor="#FF120823" android:pathData="M33,59h42v3h-42z" />
        <path android:fillColor="#FF120823" android:pathData="M33,66h42v4h-42z" />
    </group>

    <!--
      La griglia in prospettiva, sotto il sole.

      Tre righe che si allargano scendendo: è quel poco che basta a dire «anni
      ottanta» senza diventare un reticolo illeggibile in miniatura.
    -->
    <path android:fillColor="#FF22D3EE" android:fillAlpha="0.5" android:pathData="M30,76h48v1.2h-48z" />
    <path android:fillColor="#FF22D3EE" android:fillAlpha="0.38" android:pathData="M26,81h56v1.4h-56z" />
    <path android:fillColor="#FF22D3EE" android:fillAlpha="0.26" android:pathData="M21,87h66v1.6h-66z" />

    <!--
      La D del marchio, sopra al sole.

      Non c'è la scritta intera: «DAPROD PRODUZIONI» a 48 px è una macchia. Nel
      riquadro delle app si legge il nome sotto l'icona, e l'icona deve dire una
      cosa sola — questa.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40,36h13a15,15 0 0,1 0,30h-13zM47,43v16h6a8,8 0 0,0 0,-16z" />
</vector>
