<?xml version="1.0" encoding="utf-8"?>
<!--
  L'icona dell'app (1.4.7): la D di DaProd dentro un anello di neon verde e
  ciano, su vetro scuro con la pioggia di codice. È lo stesso marchio che sta
  nei giochi (la D della moneta del Coin Dozer e della Claw), coi colori della
  suite di adesso: verde #00ff41 e ciano #3ddbff.

  Chiesto da Cammo il 25 settembre 2026: «aggiorniamo l'icona android». Prima
  c'era il tramonto viola della 0.7.7, che con la suite verde non c'entrava più.

  ## Le proporzioni non sono decorative

  Il disegno sta in 108×108 come vuole un'icona adattiva, ma **tutto quello che
  conta sta nei 66 dp centrali**: fuori da lì Android ritaglia, e su certi
  telefoni ritaglia un cerchio. L'anello ha raggio 31 intorno a (54, 54), quindi
  resta dentro anche col cerchio. La pioggia può uscire: è lo sfondo.

  Il disegno di partenza, da aprire nel browser, è `docs/media/icona-android.svg`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Il fondo: verde scurissimo che va al nero. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="0" android:endY="108">
                <item android:offset="0" android:color="#FF07231A" />
                <item android:offset="1" android:color="#FF010604" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- La pioggia di codice: righe verdi che si accendono verso il basso. -->
    <path android:pathData="M9,0h3v40h-3z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="0" android:endY="40">
                <item android:offset="0" android:color="#0000FF41" />
                <item android:offset="1" android:color="#8C00FF41" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M21,18h3v46h-3z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="18" android:endX="0" android:endY="64">
                <item android:offset="0" android:color="#0000FF41" />
                <item android:offset="1" android:color="#8C00FF41" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M33,-4h3v30h-3z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="-4" android:endX="0" android:endY="26">
                <item android:offset="0" android:color="#0000FF41" />
                <item android:offset="1" android:color="#8C00FF41" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M72,4h3v34h-3z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="4" android:endX="0" android:endY="38">
