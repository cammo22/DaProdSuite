<?xml version="1.0" encoding="utf-8"?>
<!-- Una richiesta nella lista: cosa si è chiesto, a che punto è, e il tasto per
     portarsi via il file quando c'è. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/sfondo_carta"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/voce_titolo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/testo"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voce_stato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/accento"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/voce_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:textColor="@color/testo_debole"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/voce_quando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/testo_debole"
        android:textSize="11sp" />

    <Button
        android:id="@+id/btn_scarica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="0dp"
        android:paddingVertical="6dp"
        android:text="@string/btn_scarica"
        android:textSize="13sp"
        android:backgroundTint="@color/accento"
        android:visibility="gone" />

</LinearLayout>
