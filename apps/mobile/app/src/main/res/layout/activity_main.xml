<?xml version="1.0" encoding="utf-8"?>
<!--
  Tre schermate, una alla volta, nello stesso posto.

  1. **Chi sei** — l'elenco delle persone di questo telefono. È la prima cosa che
     si vede, perché era la prima cosa che mancava: sul PC la fila diceva tre
     volte «SM-A536B» e non c'era modo di sapere chi avesse chiesto cosa.
  2. **Entra** — la registrazione: un nome e un codice. È l'unica schermata che
     deve essere nativa, e per una ragione che non si aggira: prima di
     accoppiarsi non si sa a quale computer bussare, quindi non c'è nessuna
     pagina da caricare.
  3. **La suite** — una WebView sulla console. Non è un ripiego: è la stessa
     pagina che vede il portatile, e quindi le stesse schede, gli stessi moduli,
     la stessa galleria. Quando sul PC compare una scheda nuova, qui c'è al
     collegamento dopo, senza pubblicare un APK.

  ## Cosa è sparito nella 0.7.6, e perché

  **La quarta schermata, «Senza PC».** Era un menu a tendina, un modulo e una
  lista: un'app diversa da quella di due secondi prima, che compariva proprio nel
  momento in cui uno si aspettava di ritrovare la sua roba. Detto così: «al
  momento se il pc non è raggiungibile mostra un'altra schermata, questa cosa
  non va bene e non mi piace nemmeno quella schermata».

  Adesso la pagina resta la stessa e a rispondere, al posto del computer, è il
  telefono — vedi `ServitoreOffline` e `Deposito`. Con lei se ne sono andati il
  modulo nativo, la lista delle richieste e lo spinner delle azioni: c'erano
  due modi di chiedere una cosa, ed è rimasto quello buono.

  **La barra in cima, quando si è dentro la suite.** La pagina ha la sua
  testata, con il nome, la faccia e la rotella delle impostazioni: due
  intestazioni una sopra l'altra sono una di troppo. La barra torna quando si è
  fuori dalla suite, cioè quando quella testata non c'è.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/sfondo">

    <LinearLayout
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="16dp"
        android:paddingEnd="6dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/chi_sono"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/testo"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/app_name" />

        <Button
            android:id="@+id/btn_menu"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingHorizontal="0dp"
            android:text="@string/menu_puntini"
            android:textColor="@color/testo_debole"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Compare solo quando c'è davvero una versione nuova: un avviso che sta
         lì sempre smette di essere un avviso. -->
    <TextView
        android:id="@+id/banner_aggiornamento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:padding="12dp"
        android:background="@drawable/sfondo_carta"
        android:textColor="@color/accento"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- =============================== CHI SEI =============================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/schermo_utenti"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/chi_sei"
                    android:textColor="@color/testo"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="18dp"
                    android:text="@string/chi_sei_perche"
                    android:textColor="@color/testo_debole"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/elenco_utenti"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btn_nuovo_utente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/aggiungi_persona" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ================================ ENTRA ================================
             La registrazione, rifatta nella 0.7.6.

             Chiesto così: «all'avvio dell'app voglio una specie di registrazione
             molto semplice, nickname e codice o qr, ma farlo in una bella pagina
             di login». È la stessa forma della pagina web — stemma, nome, due
             passi numerati, un tasto grosso — perché è la stessa app, e la prima
             schermata non deve sembrare di un altro programma.

             **Il QR è sceso di grado, apposta.** «Il login è obbligatorio il QR,
             ma lo vorrei opzionale, il codice va benissimo». Adesso il codice è
             il primo cittadino e il QR è la riga sotto, per chi non ha voglia di
             battere otto cifre.
        -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/schermo_collega"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/sfondo_stemma"
                    android:gravity="center"
                    android:text="@string/stemma"
                    android:textColor="@color/testo"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/app_name"
                    android:textColor="@color/testo"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="22dp"
                    android:gravity="center"
                    android:text="@string/claim"
                    android:textColor="@color/testo_debole"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/sfondo_carta"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/passo_uno"
                        android:textColor="@color/accento"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/campo_nome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:inputType="textPersonName|textCapWords"
                        android:hint="@string/hint_nome"
                        android:autofillHints="name"
                        android:textColor="@color/testo"
                        android:textColorHint="@color/testo_debole" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/nota_nome"
                        android:textColor="@color/testo_debole"
                        android:textSize="11sp" />

                    <!--
                      Il tasto grosso della 0.9.0: cerca il computer.

                      Chiesto il 5 settembre 2026: «all'avvio la creazione del
                      profilo e automaticamente alla fine si vede in automatico
                      tutti i pc collegati e si decide a quale collegarsi».
                      Quindi il passo due non è più «batti otto cifre»: è
                      «guarda chi c'è». Il codice resta, sotto, per chi è fuori
                      casa — dove nessun annuncio arriva.
                    -->
                    <Button
                        android:id="@+id/btn_cerca"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/btn_cerca" />

                    <Button
                        android:id="@+id/btn_mostra_codice"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/btn_ho_un_codice"
                        android:textColor="@color/testo_debole"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/blocco_codice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/passo_due"
                        android:textColor="@color/accento"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/campo_codice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:inputType="number"
                        android:maxLength="8"
                        android:letterSpacing="0.3"
                        android:gravity="center"
                        android:textSize="21sp"
                        android:hint="@string/hint_codice"
                        android:importantForAutofill="no"
                        android:textColor="@color/testo"
                        android:textColorHint="@color/testo_debole" />

                    <EditText
                        android:id="@+id/campo_indirizzo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:inputType="textUri"
                        android:hint="@string/hint_indirizzo"
                        android:importantForAutofill="no"
                        android:textColor="@color/testo"
                        android:textColorHint="@color/testo_debole"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/nota_codice"
                        android:textColor="@color/testo_debole"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_connetti"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/btn_entra" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_scansiona"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/btn_scansiona"
                    android:textColor="@color/testo_debole"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_torna_utenti"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/torna_indietro"
                    android:textColor="@color/testo_debole"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- =============================== SCOPRI ================================
             I computer di casa, trovati da soli.

             Nasce nella 0.9.0. Prima di questa schermata collegarsi voleva dire
             farsi dettare otto cifre da chi stava davanti al PC; adesso vuol
             dire toccare un nome in un elenco. Il computer riceve una notifica
             e chi ci sta davanti decide.

             La lista si riempie da sola e non ha un tasto «cerca»: cercare è
             quello che questa schermata fa mentre è aperta.
        -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/schermo_scopri"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="@string/scopri_titolo"
                    android:textColor="@color/testo"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scopri_sotto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/scopri_sotto"
                    android:textColor="@color/testo_debole"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/elenco_computer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Mentre si aspetta che qualcuno dica di sì. Prende il posto
                     dell'elenco: in quel momento non c'è nient'altro da fare. -->
                <LinearLayout
                    android:id="@+id/blocco_attesa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@drawable/sfondo_carta"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/attesa_titolo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/testo"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/attesa_sotto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/attesa_sotto"
                        android:textColor="@color/testo_debole"
                        android:textSize="13sp" />

                    <ProgressBar
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp" />

                    <Button
                        android:id="@+id/btn_lascia_perdere"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/btn_lascia_perdere"
                        android:textColor="@color/testo_debole"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/scopri_vuoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="14dp"
                    android:background="@drawable/sfondo_carta"
                    android:text="@string/scopri_vuoto"
                    android:textColor="@color/testo_debole"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_scopri_codice"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/btn_uso_un_codice"
                    android:textColor="@color/testo_debole"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ============================== LA SUITE =============================== -->
        <!-- La console. Col computer acceso la serve lui; col computer spento la
             serve il telefono, dalla copia che ha tenuto. In tutti e due i casi
             è la stessa pagina: vedi `ServitoreOffline`. -->
        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/attesa"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
