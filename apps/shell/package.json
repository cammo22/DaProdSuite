{
  "name": "@daprod/shell",
  "version": "0.7.8",
  "private": true,
  "description": "Guscio della suite: hub, installazione, aggiornamenti, avvio delle app.",
  "main": "out/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.mjs",
    "dev": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder --win --config electron-builder.yml --publish never",
    "icone": "node scripts/genera-icone.cjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@daprod/azioni": "workspace:*",
    "@daprod/gateway": "workspace:*",
    "@daprod/ipc": "workspace:*",
    "@daprod/runtime": "workspace:*",
    "electron-updater": "^6.6.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3"
  }
}
